{
  "expo": {
    "name": "bazaar",
    "slug": "bazaar",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "bazaar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bazaar.mu",
      "buildNumber": "14",
      "googleServicesFile": "./config/GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required for video calls",
        "NSMicrophoneUsageDescription": "Microphone access is required for voice and video calls",
        "NSPhotoLibraryAddUsageDescription": "Photo access is required to save images to your device",
        "NSPhotoLibraryUsageDescription": "Photo access is required to save images to your device",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bazaar.mu",
      "versionCode": 9,
      "permissions": [
        "INTERNET",
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "inset-swipe",
          "position": "absolute"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "gradleVersion": "8.13",
            "androidGradlePluginVersion": "8.7.1"
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "412a8c2d-c44a-459b-863e-3ddad810fe26"
      }
    }
  }
}
